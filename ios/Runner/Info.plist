			</array>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key> 
	<string>We use your camera to upload profile and event photos.</string> <!-- Photo Library --> 
	<key>NSPhotoLibraryUsageDescription</key> 
	<string>We access your photos to let you upload images.</string>
